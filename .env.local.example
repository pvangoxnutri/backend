# SideQuest backend - local development env vars
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is loaded by Program.cs LoadLocalEnvFile() at startup.
#
# Format: KEY=value
# ASP.NET Core maps double-underscore (__) to colon (:) in config keys,
# so "Supabase__Url" populates configuration key "Supabase:Url".

# ─── Database (Supabase Postgres via Pooler) ──────────────────────────────
ConnectionStrings__DefaultConnection=Host=aws-1-eu-west-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.YOUR_PROJECT_REF;Password=YOUR_DATABASE_PASSWORD;SSL Mode=Disable

# ─── Supabase Auth + Storage ──────────────────────────────────────────────
Supabase__Url=https://YOUR_PROJECT_REF.supabase.co
Supabase__ServiceRoleKey=YOUR_SUPABASE_SERVICE_ROLE_KEY
Supabase__JwtAudience=authenticated
# Public bucket name in Supabase Storage. Create it once in the Supabase dashboard.
Supabase__StorageBucket=sidequest-uploads

# ─── External APIs ────────────────────────────────────────────────────────
GoogleMaps__ApiKey=YOUR_GOOGLE_MAPS_API_KEY

# ─── Frontend base URL (used for emails, links) ───────────────────────────
Frontend__BaseUrl=http://localhost:3000

# ─── Environment ──────────────────────────────────────────────────────────
# Leave unset for Development; set to Production when running in prod
# ASPNETCORE_ENVIRONMENT=Development
