# SideQuest backend - local development env vars
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is loaded by Program.cs LoadLocalEnvFile() at startup.
#
# Format: KEY=value
# ASP.NET Core maps double-underscore (__) to colon (:) in config keys,
# so "Supabase__Url" populates configuration key "Supabase:Url".

# ─── Database (Supabase Postgres via Pooler) ──────────────────────────────
ConnectionStrings__DefaultConnection=Host=aws-1-eu-west-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.YOUR_PROJECT_REF;Password=YOUR_DATABASE_PASSWORD;SSL Mode=Disable

# ─── Supabase Auth + Storage ──────────────────────────────────────────────
Supabase__Url=https://YOUR_PROJECT_REF.supabase.co
Supabase__ServiceRoleKey=YOUR_SUPABASE_SERVICE_ROLE_KEY
Supabase__JwtAudience=authenticated
# Public bucket name in Supabase Storage. Create it once in the Supabase dashboard.
Supabase__StorageBucket=sidequest-uploads
# Create a separate PRIVATE bucket for trip documents in the Supabase dashboard:
# Public bucket = OFF (public=false), file size limit = 10 MiB, and allowed MIME
# types = application/pdf, image/jpeg, image/png, image/webp.
# The backend opens files only through short-lived signed URLs.
Supabase__DocumentsStorageBucket=trip-documents

# ─── External APIs ────────────────────────────────────────────────────────
GoogleMaps__ApiKey=YOUR_GOOGLE_MAPS_API_KEY

# ─── Gluno (AI travel expert) ─────────────────────────────────────────────
# SERVER-SIDE ONLY. This key must never appear in the mobile app or in any
# EXPO_PUBLIC_* variable — the app calls /api/gluno and the backend calls the
# model API on its behalf (see backend/Services/Gluno/).
Gluno__ApiKey=YOUR_ANTHROPIC_API_KEY
#
# Whether Gluno is served at all. Defaults to ON in Development and OFF
# everywhere else, so a production deploy cannot start answering just because
# a key happens to be set. Set explicitly to override:
# Gluno__Enabled=true
#
# ─── Models ───────────────────────────────────────────────────────────────
# REQUIRED. No model id is hardcoded anywhere in the Gluno implementation, so
# a retired or renamed model is a config change rather than a deploy. Missing
# or blank means Gluno reports itself "not_configured" and the app hides the
# entry point — it never fails mid-turn with a provider 400 the user can't act
# on.
#
# Model ids are SERVER-SIDE. The app never learns which model answered.
Gluno__Models__Primary=claude-opus-5
#
# Legacy alias, still read as a fallback for Primary so an older deployment
# keeps working across the upgrade. Prefer the line above; nothing new should
# set this.
#   Gluno__Model
#
# Optional. Both fall back to Primary, so a deployment that sets only the line
# above works — it just pays primary prices for everything, which is the safe
# direction to fail in.
#   Gluno__Models__Fast    app help, short answers, preference updates
#   Gluno__Models__Review   grounding regeneration
# Gluno__Models__Fast=claude-haiku-4-5
# Gluno__Models__Review=claude-opus-5
#
# Optional tuning, no redeploy needed:
#   Gluno__Effort     low|medium|high|max (default medium — it's a phone chat
#                                          panel, so latency counts)
#   Gluno__MaxTokens  reply ceiling       (default 4096)
#   Gluno__MaxModelRounds  hard ceiling on model rounds per turn (default 4)
#   Gluno__Temperature__Simple    (default 0.3 — formatting structured data)
#   Gluno__Temperature__Moderate  (default 0.7 — recommendations need a view)
#   Gluno__Temperature__Complex   (default 0.7)
#   Gluno__TimeoutSeconds__Fast     (default 20)
#   Gluno__TimeoutSeconds__Primary  (default 60)
#   Gluno__MaxExternalSearchesPerHour  per-user ceiling on external place
#                                      lookups (default 60). A runaway
#                                      backstop, not a plan tier.

# ─── Latency budgets (seconds per turn shape) ─────────────────────────────
# These are BUDGETS, not timeouts. When one runs low Gluno does less — skips
# optional hydration, stops starting expensive work — rather than waiting
# longer. Raising them all is exactly the wrong fix for a slow answer.
#   Gluno__Latency__HelpSeconds            (default 8)
#   Gluno__Latency__SimpleSeconds          (default 12)
#   Gluno__Latency__RecommendationSeconds  (default 25)
#   Gluno__Latency__ReviewSeconds          (default 20)
#   Gluno__Latency__DayPlanSeconds         (default 45)
#   Gluno__Latency__ItinerarySeconds       (default 60)

# ─── Context budget ───────────────────────────────────────────────────────
# Far below the model's window on purpose. This is chosen for latency and
# answer quality, not as a technical ceiling — a bloated context is slower,
# dilutes attention away from the actual question, and is mostly untrusted
# external text.
#   Gluno__Context__MaxTokens  (default 24000)

# ─── Usage ceilings ───────────────────────────────────────────────────────
# A runaway backstop, NOT a paywall or a plan tier. When a ceiling is hit,
# Gluno stops answering and says so neutrally — existing conversations still
# open and scroll, and the rest of SideQuest is untouched.
#   Gluno__Usage__UserHourlyTurns          (default 60)
#   Gluno__Usage__UserDailyTurns           (default 300)
#   Gluno__Usage__GlobalDailyOutputTokens  (default 5000000)
#
# Optional pricing, for cost estimates in the logs. Per MILLION tokens, in
# whatever currency you set. Unset means cost is simply not estimated — a
# wrong number would be worse than none, since a hardcoded rate silently
# becomes a lie the moment prices change.
#   Gluno__Pricing__InputPerMillion
#   Gluno__Pricing__OutputPerMillion

# ─── Tripadvisor (Gluno's external travel data) ───────────────────────────
# SERVER-SIDE ONLY, exactly like the Gluno key: never an EXPO_PUBLIC_* value,
# never returned in an API response, never written to a log. Note that the
# Content API takes the key as a QUERY PARAMETER, which is why the HTTP client
# is registered with .RemoveAllLoggers() in Program.cs — without that, every
# request URI (key included) would be logged.
#
# OFF unless you switch it on. Shipping the integration must not enable it;
# production turns it on deliberately or not at all. With it off, Gluno still
# works — it just says it cannot look places up.
# Tripadvisor__Enabled=true
# Tripadvisor__ApiKey=YOUR_TRIPADVISOR_CONTENT_API_KEY
#
# Official Content API host. Only this host is ever called, and only on fixed
# paths — no URL from the model or from a provider response is ever requested.
# Tripadvisor__BaseUrl=https://api.content.tripadvisor.com
#
# Some Content API keys are locked to a registered referrer. Set it if yours is.
# Tripadvisor__Referer=https://sidequesttravel.app
#
# Optional tuning:
#   Tripadvisor__TimeoutSeconds        per request, 2-20        (default 6)
#   Tripadvisor__MaxDetailHydrations   detail calls per search  (default 6)
#   Tripadvisor__IncludePhotos         one photo per place      (default true)
#   Tripadvisor__IncludeReviewSnippets extra call per place     (default false)
#   Tripadvisor__SearchCacheMinutes    search cache TTL         (default 10)
#   Tripadvisor__DetailsCacheHours     details cache TTL        (default 24)

# ─── Routing (Gluno's verified travel times) ──────────────────────────────
# SERVER-SIDE ONLY. Never an EXPO_PUBLIC_* value, never in an API response,
# never in a log. /api/gluno/status reports only a boolean — whether verified
# travel times are available — and never which provider or on what credentials.
#
# OFF unless you switch it on, like every other external integration here.
# Deploying this code must not start calling a paid API by itself. With it off
# Gluno still plans days; it works from straight-line distances and is required
# to say its travel times are estimates rather than measured.
#
# Google Routes API (routes.googleapis.com, :computeRouteMatrix). Chosen
# because SideQuest's map integration is already Google, so place coordinates
# and route coordinates come from the same reference frame.
# Routing__Enabled=true
#
# Falls back to GoogleMaps__ApiKey when unset, so routing can be enabled
# without provisioning a second credential. Enable the Routes API on the key.
# Routing__ApiKey=YOUR_GOOGLE_ROUTES_API_KEY
#
# Only this host is ever called, and only on one fixed path. No caller — and
# certainly no model — can supply a host, a path or a query.
# Routing__BaseUrl=https://routes.googleapis.com
#
# Optional tuning:
#   Routing__TimeoutSeconds       per request, 2-20            (default 8)
#   Routing__MaxMatrixElements    origin x destination cap     (default 64,
#                                 hard max 100 — Google's own transit limit)
#   Routing__MaxRequestsPerTurn   provider calls per Gluno turn (default 4).
#                                 The backstop: a planner bug that loops
#                                 cannot run up a bill.
#   Routing__MaxRoutableKm        coarse filter — past this a leg is an
#                                 intercity journey and is not routed
#                                 (default 150)
#   Routing__CacheMinutesDriving  traffic changes hourly        (default 20)
#   Routing__CacheMinutesTransit  timetables are stable per day (default 120)
#   Routing__CacheMinutesWalking  a walk between two fixed points does not
#                                 change                        (default 10080)

# ─── Planning (Gluno's day-schedule assumptions) ──────────────────────────
# SideQuest's own estimates for how long things take. NOT facts about any
# specific place — they are presented to the user as assumptions and are
# editable in proposal review before anything is saved.
#
#   Planning__Durations__<category>   minutes for one stop, e.g.
#                                     Planning__Durations__museum=120
#                                     Planning__Durations__dinner=90
#   Planning__BufferMinutes__relaxed  slack after a stop        (default 30)
#   Planning__BufferMinutes__balanced                           (default 20)
#   Planning__BufferMinutes__packed                             (default 10)

# ─── Frontend base URL (used for emails, links) ───────────────────────────
Frontend__BaseUrl=http://localhost:3000

# ─── Environment ──────────────────────────────────────────────────────────
# Leave unset for Development; set to Production when running in prod
# ASPNETCORE_ENVIRONMENT=Development

# ─── Gluno document analysis ──────────────────────────────────────────────
# Reads booking documents the user has ALREADY uploaded — flight tickets,
# hotel confirmations, ferry bookings — and turns them into reviewable
# suggestions. Never automatic: the user taps "Analyze with Gluno", reviews
# what was found, and picks which items become proposals. Nothing is ever
# written to an Adventure without the normal review-and-apply flow.
#
# OFF by default, like every other external integration here. Shipping this
# code must not start reading people's booking confirmations — that is a
# deliberate, per-environment decision or none at all. With it off, document
# upload, viewing and sharing all work exactly as before.
#
# Uses the same Gluno__ApiKey. No separate credential, and nothing about this
# reaches the mobile app beyond one boolean: whether analysis is available.
# Gluno__Documents__Enabled=true
#
# Optional. Falls back to Gluno__Models__Primary — pin it separately if
# document reading and conversation should use different models.
# Gluno__Documents__Model=claude-opus-5
#
# Optional tuning:
#   Gluno__Documents__MaxFileSizeBytes  (default 10485760 — 10 MB)
#   Gluno__Documents__MaxPages          (default 8; a booking confirmation is
#                                        1-3 pages, a 200-page PDF is a
#                                        different kind of document)
#   Gluno__Documents__MaxImages         (default 4)
#   Gluno__Documents__TimeoutSeconds    (default 90)
#   Gluno__Documents__DailyPerUserLimit (default 30) — a runaway backstop
#   Gluno__Documents__GlobalDailyLimit  (default 2000)
#
# How long a working file may survive a crashed analysis before the sweeper
# removes it. Deliberately short: these are somebody's flight tickets sitting
# outside the storage system built to protect them, and the only reason the
# window exists at all is to catch a process that died mid-run.
#   Gluno__Documents__TemporaryFileRetentionMinutes  (default 15)
#
# Whether extracted text may be kept on the analysis row. OFF by default —
# the structured result is what the product needs, and the full text is a
# second copy of a private document living in a database.
#   Gluno__Documents__StoreRawText  (default false)

# ─── Gluno live travel information ────────────────────────────────────────
# Current conditions from outside SideQuest: strikes, closures, events,
# public holidays, official warnings. A separate provider layer from
# Tripadvisor, routing and weather — different sources, different lifetimes,
# different rules about what may be stated.
#
# OFF by default, like every other external integration here.
#
# Retrieval happens on the MODEL PROVIDER's side via its hosted web-search
# tool. That matters for two reasons: SideQuest does no scraping, so robots
# and content licensing are handled by a licensed retrieval path rather than
# by us guessing; and this backend never receives a URL to fetch, so the
# classic SSRF shape ("here is a link, go and get it") does not exist on this
# path at all. URLs that come BACK are still validated before being shown.
#
# Uses the same Gluno__ApiKey.
# Gluno__LiveInfo__Enabled=true
#
# Optional. Falls back to Gluno__Models__Primary.
# Gluno__LiveInfo__Model=claude-opus-5
#
# The hosted search tool version. Configurable because older models take the
# basic variant — a wrong value here fails the whole search, so change it only
# alongside a model change.
# Gluno__LiveInfo__ToolVersion=web_search_20260209
#
# Optional tuning:
#   Gluno__LiveInfo__TimeoutSeconds        (default 25)
#   Gluno__LiveInfo__MaxSearchesPerTurn    (default 2) — the model cannot
#                                          widen this; the turn plan decides
#   Gluno__LiveInfo__MaxSourcesPerSearch   (default 4)
#
# Cache lifetimes, per category. The spread is the point: a holiday calendar
# does not move, and a strike is a different fact in twenty minutes. One TTL
# for both either serves stale disruption data or re-fetches a calendar
# nobody changed.
#   Gluno__LiveInfo__Cache__DisruptionMinutes  strikes, transport (default 20)
#   Gluno__LiveInfo__Cache__UrgentMinutes      roads, weather, safety (default 60)
#   Gluno__LiveInfo__Cache__ClosureHours       (default 6)
#   Gluno__LiveInfo__Cache__EventHours         (default 24; re-validated
#                                              automatically within 3 days of
#                                              the date)
#   Gluno__LiveInfo__Cache__StableHours        holidays, border rules
#                                              (default 168)
